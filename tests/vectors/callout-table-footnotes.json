{
 "slug": "callout-table-footnotes",
 "module": "callout-table-footnotes/src/footnotes",
 "function": "scanFootnotes",
 "note": "args = [note text]; expected = numbers (id to number, in order of first reference, only ids with a definition), missing (referenced, no definition), unused (defined, never referenced), refs as [id, zero based line, zero based column of \"[\", context body|callout|quote|table], defs as [id, zero based line, definition text]. References in code spans, code blocks, front matter and after a backslash do not count. Reviewed by hand against each text. Inline footnotes on one line use an id with their line and column. Inline and named footnotes share one number order.",
 "cases": [
  {
   "name": "one body reference",
   "args": [
    "A claim.[^1]\n\n[^1]: The source.\n"
   ],
   "expected": {
    "numbers": {
     "1": 1
    },
    "missing": [],
    "unused": [],
    "refs": [
     [
      "1",
      0,
      8,
      "body"
     ]
    ],
    "defs": [
     [
      "1",
      2,
      "The source."
     ]
    ]
   }
  },
  {
   "name": "reference inside a callout",
   "args": [
    "> [!note] Title\n> Text[^a] here.\n\n[^a]: Def A.\n"
   ],
   "expected": {
    "numbers": {
     "a": 1
    },
    "missing": [],
    "unused": [],
    "refs": [
     [
      "a",
      1,
      6,
      "callout"
     ]
    ],
    "defs": [
     [
      "a",
      3,
      "Def A."
     ]
    ]
   }
  },
  {
   "name": "reference inside a table cell",
   "args": [
    "| H | I |\n| - | - |\n| x[^t] | y |\n\n[^t]: Def T.\n"
   ],
   "expected": {
    "numbers": {
     "t": 1
    },
    "missing": [],
    "unused": [],
    "refs": [
     [
      "t",
      2,
      3,
      "table"
     ]
    ],
    "defs": [
     [
      "t",
      4,
      "Def T."
     ]
    ]
   }
  },
  {
   "name": "reference inside a plain quote",
   "args": [
    "> Quoted[^q] text.\n\n[^q]: Def Q.\n"
   ],
   "expected": {
    "numbers": {
     "q": 1
    },
    "missing": [],
    "unused": [],
    "refs": [
     [
      "q",
      0,
      8,
      "quote"
     ]
    ],
    "defs": [
     [
      "q",
      2,
      "Def Q."
     ]
    ]
   }
  },
  {
   "name": "numbers follow the first reference, not the definitions",
   "args": [
    "B[^b] then A[^a] then B again[^b].\n\n[^a]: Def A.\n[^b]: Def B.\n"
   ],
   "expected": {
    "numbers": {
     "b": 1,
     "a": 2
    },
    "missing": [],
    "unused": [],
    "refs": [
     [
      "b",
      0,
      1,
      "body"
     ],
     [
      "a",
      0,
      12,
      "body"
     ],
     [
      "b",
      0,
      29,
      "body"
     ]
    ],
    "defs": [
     [
      "a",
      2,
      "Def A."
     ],
     [
      "b",
      3,
      "Def B."
     ]
    ]
   }
  },
  {
   "name": "a reference with no definition is missing and gets no number",
   "args": [
    "One[^1] and two[^2].\n\n[^1]: Def one.\n"
   ],
   "expected": {
    "numbers": {
     "1": 1
    },
    "missing": [
     "2"
    ],
    "unused": [],
    "refs": [
     [
      "1",
      0,
      3,
      "body"
     ],
     [
      "2",
      0,
      15,
      "body"
     ]
    ],
    "defs": [
     [
      "1",
      2,
      "Def one."
     ]
    ]
   }
  },
  {
   "name": "a definition with no reference is unused",
   "args": [
    "Text.\n\n[^x]: Never used.\n[^y]: Also never used.\n"
   ],
   "expected": {
    "numbers": {},
    "missing": [],
    "unused": [
     "x",
     "y"
    ],
    "refs": [],
    "defs": [
     [
      "x",
      2,
      "Never used."
     ],
     [
      "y",
      3,
      "Also never used."
     ]
    ]
   }
  },
  {
   "name": "a reference in an inline code span is ignored",
   "args": [
    "Code `[^1]` and real[^2].\n\n[^1]: One.\n[^2]: Two.\n"
